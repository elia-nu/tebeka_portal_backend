{
  "name": "financial-service",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/financial-service/src",
  "projectType": "application",
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/apps/financial-service",
        "main": "apps/financial-service/src/main.ts",
        "outputFileName": "apps/financial-service/src/main.js",
        "tsConfig": "apps/financial-service/tsconfig.app.json",
        "rootDir": "."
      }
    },
    "serve": {
      "executor": "@nx/js:node",
      "options": {
        "buildTarget": "financial-service:build",
        "runtimeArgs": ["-r", "ts-node/register/transpile-only", "-r", "tsconfig-paths/register"],
        "inspect": false
      }
    }
  }
}
