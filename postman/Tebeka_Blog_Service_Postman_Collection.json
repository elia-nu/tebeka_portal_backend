            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Ethiopian Commercial Code Reform: Guidelines for Cross-Border M&A (Updated)\",\n  \"excerpt\": \"Updated guidance incorporating Ministry of Trade registration regulations.\",\n  \"tags\": [\n    \"Commercial Law\",\n    \"M&A\",\n    \"Trade Ministry\"\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/blogs/:blogId",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "blogs",
                "{{blogId}}"
              ]
            },
            "description": "Updates content, title, tags, or excerpt of an existing draft or rejected article."
          },
          "event": [],
          "response": []
        },
        {
          "name": "2.5 POST Submit Blog Post for Editorial Review",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{attorneyAuthToken}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/blogs/:blogId/submit-for-review",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "blogs",
                "{{blogId}}",
                "submit-for-review"
              ]
            },
            "description": "Submits draft or revised article to admin moderation queue. Sets status to PENDING_REVIEW and sends in-app notification to administrators."
          },
          "event": [],
          "response": []
        },
        {
          "name": "2.6 DELETE Delete My Blog Post",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{attorneyAuthToken}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/blogs/:blogId",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "blogs",
                "{{blogId}}"
              ]
            },
            "description": "Allows authors to delete their own unapproved or draft articles."
          },
          "event": [],
          "response": []
        }
      ]
