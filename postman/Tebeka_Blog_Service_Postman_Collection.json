            "description": "Posts a top-level comment on the article."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "",
                  "if (pm.response.code === 201 || pm.response.code === 200) {",
                  "  var data = pm.response.json();",
                  "  pm.environment.set(\"commentId\", data.id);",
                  "}",
                  ""
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "3.3 POST Reply to Comment (Threaded)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{attorneyAuthToken}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"content\": \"Thank you Sara! Under Article 324, board meetings require a quorum of at least 50% voting shareholders unless otherwise specified in the articles of association.\",\n  \"parentId\": \"{{commentId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/blogs/:blogId/comments",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "blogs",
                "{{blogId}}",
                "comments"
              ]
            },
            "description": "Creates a nested reply to an existing comment. Automatically alerts parent commenter."
          },
          "event": [],
          "response": []
        },
