    {
      "name": "2. ⚖️ Role: Attorney / Author",
      "description": "Authoring workflows for attorneys: creating drafts, updating articles, submitting drafts for admin moderation, and tracking personal article statistics.",
      "item": [
        {
          "name": "2.1 POST Create Blog Post (Draft)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{attorneyAuthToken}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Ethiopian Commercial Code Reform: Guidelines for Cross-Border M&A\",\n  \"content\": \"The revised Ethiopian Commercial Code introduces groundbreaking modernizations for private limited companies and corporate structuring in Addis Ababa. Here are key legal considerations for foreign investors...\",\n  \"excerpt\": \"Key takeaways and legal updates on the newly revised Commercial Code.\",\n  \"categoryId\": \"{{categoryId}}\",\n  \"caseCategory\": \"Commercial Law\",\n  \"tags\": [\n    \"Commercial Law\",\n    \"M&A\",\n    \"Foreign Investment\"\n  ],\n  \"isFeatured\": false,\n  \"submitForReview\": false\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/blogs",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "blogs"
              ]
            },
            "description": "Creates a new blog post in DRAFT status."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "",
                  "if (pm.response.code === 201 || pm.response.code === 200) {",
                  "  var data = pm.response.json();",
                  "  pm.environment.set(\"blogId\", data.id);",
                  "  pm.environment.set(\"blogSlug\", data.slug);",
                  "}",
                  ""
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "2.2 POST Create Blog Post with Featured Image (Multipart)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{attorneyAuthToken}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "title",
                  "value": "Arbitration Clauses in Ethiopian Construction Contracts",
                  "type": "text"
                },
                {
                  "key": "content",
                  "value": "Arbitration remains the preferred mechanism for resolving dispute in large scale infrastructure projects in Ethiopia...",
                  "type": "text"
                },
                {
                  "key": "excerpt",
                  "value": "Legal insights on drafting effective arbitration clauses under Ethiopian law.",
                  "type": "text"
                },
                {
                  "key": "caseCategory",
                  "value": "Arbitration",
                  "type": "text"
                },
                {
                  "key": "tags",
                  "value": "Arbitration, Construction Law, Dispute Resolution",
                  "type": "text"
                },
                {
                  "key": "submitForReview",
                  "value": "false",
                  "type": "text"
                },
                {
                  "key": "featuredImage",
                  "type": "file",
                  "src": ""
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/blogs",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "blogs"
              ]
            },
            "description": "Uploads a blog post with an image attachment (JPEG, PNG, WebP up to 5MB)."
          },
          "event": [],
          "response": []
        },
