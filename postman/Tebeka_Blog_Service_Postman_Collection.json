        {
          "name": "4.2 Editorial Moderation & Approval Queue",
          "item": [
            {
              "name": "4.2.1 GET Admin Moderation Queue",
              "request": {
                "method": "GET",
                "header": [
                  {
                    "key": "Accept",
                    "value": "application/json",
                    "type": "text"
                  },
                  {
                    "key": "Authorization",
                    "value": "Bearer {{adminAuthToken}}",
                    "type": "text"
                  }
                ],
                "url": {
                  "raw": "{{baseUrl}}/admin/blogs?status=PENDING_REVIEW&search=&page=1&limit=15",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "admin",
                    "blogs"
                  ],
                  "query": [
                    {
                      "key": "status",
                      "value": "PENDING_REVIEW",
                      "description": "PENDING_REVIEW | DRAFT | PUBLISHED | REJECTED"
                    },
                    {
                      "key": "search",
                      "value": "",
                      "description": "Search by title, content, or author"
                    },
                    {
