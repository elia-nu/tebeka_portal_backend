              "mode": "raw",
              "raw": "{\n  \"content\": \"Excellent analysis! Does the new legislation mandate specific quorum requirements for private limited company board meetings?\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/blogs/:blogId/comments",
              "host": [
                "{{baseUrl}}"
