{
  "info": {
    "_postman_id": "tebeka-blog-service-rbac-collection-v1",
    "name": "Tebeka Portal - Blog Service (Role-Based API Collection)",
    "description": "Production-grade, end-to-end Postman collection for Tebeka Portal Blog & Editorial Engine. Structured by RBAC Role: Public/Anonymous Visitor, Attorney Author, Client/Reader Community, and Admin/Moderator.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. 🌐 Role: Public / Anonymous Visitor",
      "description": "Open endpoints accessible to unauthenticated public visitors for blog discovery, category browsing, article reading, and social sharing.",
      "item": [
        {
          "name": "1.1 GET Public Published Blogs (Filter & Search)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/public/blogs?page=1&limit=12&category=Commercial Law&tag=M&A&search=Commercial&sortBy=newest",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "public",
                "blogs"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1",
                  "description": "Page number"
                },
                {
                  "key": "limit",
                  "value": "12",
                  "description": "Items per page"
                },
                {
                  "key": "category",
                  "value": "Commercial Law",
                  "description": "Filter by category slug/name"
                },
                {
                  "key": "tag",
                  "value": "M&A",
                  "description": "Filter by tag"
                },
                {
                  "key": "search",
                  "value": "Commercial",
                  "description": "Full-text search in title, excerpt, and content"
                },
                {
                  "key": "sortBy",
                  "value": "newest",
                  "description": "Sorting: newest | popular | most_liked | most_viewed"
                }
              ]
            },
            "description": "Returns paginated list of published articles with author and category info."
          },
          "event": [],
          "response": []
        },
        {
          "name": "1.2 GET Public Blog Categories",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/public/blog-categories",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "public",
                "blog-categories"
              ]
            },
            "description": "Lists all active blog categories along with live publishedPostCount counters."
          },
          "event": [],
          "response": []
        },
        {
          "name": "1.3 GET Public Blog Post by Slug or ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/public/blogs/:blogSlug",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "public",
                "blogs",
                "{{blogSlug}}"
              ]
            },
            "description": "Fetches full published article details. Automatically increments view count and returns comments tree."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "",
                  "if (pm.response.code === 200) {",
                  "  var data = pm.response.json();",
                  "  pm.environment.set(\"blogId\", data.id);",
                  "  pm.environment.set(\"blogSlug\", data.slug);",
                  "}",
                  ""
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "1.4 GET Public Comments for Blog Post",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/public/blogs/:blogId/comments?page=1&limit=20",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "public",
                "blogs",
                "{{blogId}}",
                "comments"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1",
                  "description": "Page number"
                },
                {
                  "key": "limit",
                  "value": "20",
                  "description": "Number of top-level comments per page"
                }
              ]
            },
            "description": "Retrieves top-level approved comments and their nested replies."
          },
          "event": [],
          "response": []
        },
        {
          "name": "1.5 POST Record Article Share",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"platform\": \"TELEGRAM\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/blogs/:blogId/share",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "blogs",
                "{{blogId}}",
