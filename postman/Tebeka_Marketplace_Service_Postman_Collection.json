    {
      "name": "03. Attorney Role Superfolder",
      "description": "Endpoints used by authenticated Attorneys: viewing their bookings, managing cases, uploading documents.",
      "item": [
        {
          "name": "Bookings",
          "description": "View and manage bookings assigned to the attorney.",
          "item": [
            {
              "name": "Get My Bookings (Attorney)",
              "request": {
                "auth": {
                  "type": "bearer",
                  "bearer": [{ "key": "token", "value": "{{attorneyAuthToken}}", "type": "string" }]
                },
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{marketplaceUrl}}/bookings?page=1&limit=20&role=ATTORNEY&sortBy=bookingDate&sortOrder=desc",
                  "host": ["{{marketplaceUrl}}"],
                  "path": ["bookings"],
                  "query": [
                    { "key": "page", "value": "1" },
                    { "key": "limit", "value": "20" },
                    { "key": "role", "value": "ATTORNEY" },
                    { "key": "status", "value": "", "description": "PENDING | CONFIRMED | CANCELLED | COMPLETED | NOSHOW | EXPIRED", "disabled": true },
                    { "key": "paymentStatus", "value": "", "disabled": true },
                    { "key": "consultationType", "value": "", "disabled": true },
                    { "key": "fromDate", "value": "", "disabled": true },
                    { "key": "toDate", "value": "", "disabled": true },
                    { "key": "sortBy", "value": "bookingDate" },
                    { "key": "sortOrder", "value": "desc" }
                  ]
                },
                "description": "List all bookings assigned to the authenticated attorney."
              }
            },
            {
              "name": "Get Booking by ID (Attorney)",
              "request": {
                "auth": {
                  "type": "bearer",
                  "bearer": [{ "key": "token", "value": "{{attorneyAuthToken}}", "type": "string" }]
                },
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{marketplaceUrl}}/bookings/{{bookingId}}",
                  "host": ["{{marketplaceUrl}}"],
                  "path": ["bookings", "{{bookingId}}"]
                },
                "description": "Attorney views a specific booking detail."
              }
            },
            {
              "name": "Update Booking Status (Confirm/Complete)",
              "request": {
                "auth": {
                  "type": "bearer",
                  "bearer": [{ "key": "token", "value": "{{attorneyAuthToken}}", "type": "string" }]
                },
                "method": "PATCH",
                "header": [
                  { "key": "Content-Type", "value": "application/json" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"status\": \"CONFIRMED\",\n  \"reason\": \"Confirmed by attorney\"\n}"
                },
                "url": {
                  "raw": "{{marketplaceUrl}}/bookings/{{bookingId}}/status",
                  "host": ["{{marketplaceUrl}}"],
                  "path": ["bookings", "{{bookingId}}", "status"]
                },
                "description": "Attorney updates a booking's status.\n\n**status**: PENDING | CONFIRMED | CANCELLED | COMPLETED | NOSHOW | EXPIRED\n**reason**: Optional explanation (max 500 chars)"
              }
            },
            {
              "name": "Cancel Booking (Attorney)",
              "request": {
                "auth": {
                  "type": "bearer",
                  "bearer": [{ "key": "token", "value": "{{attorneyAuthToken}}", "type": "string" }]
                },
                "method": "POST",
