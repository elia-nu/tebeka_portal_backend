{
  "info": {
    "_postman_id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
    "name": "Tebeka Marketplace Service ⚖️ (Role-Based & Functional)",
    "description": "Comprehensive Postman collection for the Tebeka Marketplace Service.\n\nOrganized into:\n- **Role-Based Superfolders**: Public/Anonymous, Client, Attorney, Admin\n- **Functional Subfolders**: Discovery, Search, Bookings, Cases, Documents, Reviews, Ranking\n\nAll requests route through the API Gateway at {{marketplaceUrl}} (default: http://localhost:3000/api/v1).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "marketplaceUrl",
      "value": "{{marketplaceUrl}}",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01. Public & Anonymous (No Auth Required)",
      "description": "Endpoints accessible without authentication. Discovery, search, public reviews, and ranking weights.",
      "item": [
        {
          "name": "Discovery",
          "description": "Browse and discover verified attorneys on the marketplace.",
          "item": [
            {
              "name": "Browse Attorneys (Public Directory)",
              "request": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{marketplaceUrl}}/discovery/attorneys?page=1&limit=20&sortBy=searchScore&sortOrder=desc",
                  "host": ["{{marketplaceUrl}}"],
                  "path": ["discovery", "attorneys"],
                  "query": [
                    { "key": "page", "value": "1", "description": "Page number (default: 1)" },
                    { "key": "limit", "value": "20", "description": "Items per page (1-100, default: 20)" },
                    { "key": "city", "value": "", "description": "Filter by city", "disabled": true },
                    { "key": "feeBand", "value": "", "description": "Filter by fee band", "disabled": true },
                    { "key": "practiceAreaId", "value": "{{practiceAreaId}}", "description": "Filter by practice area UUID", "disabled": true },
                    { "key": "language", "value": "", "description": "Filter by language (e.g. en, am)", "disabled": true },
                    { "key": "minRating", "value": "3", "description": "Minimum rating (0-5)", "disabled": true },
                    { "key": "minExperience", "value": "2", "description": "Minimum experience years", "disabled": true },
                    { "key": "minResponsiveness", "value": "", "description": "Minimum responsiveness score", "disabled": true },
                    { "key": "sortBy", "value": "searchScore", "description": "Sort: searchScore | rating | experienceScore | responsivenessScore" },
                    { "key": "sortOrder", "value": "desc", "description": "Sort order: asc | desc" }
                  ]
                },
                "description": "Public directory of verified attorneys. No auth required. Supports filtering by city, fee band, practice area, language, rating, and experience."
              }
            },
            {
              "name": "Get Attorney Details (Public Profile)",
              "request": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{marketplaceUrl}}/discovery/attorneys/{{attorneyProfileId}}",
                  "host": ["{{marketplaceUrl}}"],
                  "path": ["discovery", "attorneys", "{{attorneyProfileId}}"]
                },
                "description": "Retrieve the full public profile of a specific attorney by their profile ID. No auth required."
              }
            }
          ]
        },
        {
          "name": "Search",
          "description": "Full-text attorney search (public, anonymous-friendly).",
          "item": [
            {
              "name": "Search Attorneys (Full-Text)",
              "request": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{marketplaceUrl}}/search/attorneys?q=family law&page=1&limit=20&sortBy=searchScore&sortOrder=desc",
                  "host": ["{{marketplaceUrl}}"],
                  "path": ["search", "attorneys"],
                  "query": [
                    { "key": "q", "value": "family law", "description": "Search query string" },
                    { "key": "page", "value": "1" },
                    { "key": "limit", "value": "20" },
                    { "key": "city", "value": "", "description": "Filter by city", "disabled": true },
                    { "key": "feeBand", "value": "", "description": "Filter by fee band", "disabled": true },
                    { "key": "practiceAreaId", "value": "", "description": "Filter by practice area UUID", "disabled": true },
                    { "key": "language", "value": "", "description": "Filter by language", "disabled": true },
                    { "key": "minRating", "value": "", "description": "Minimum rating (0-5)", "disabled": true },
                    { "key": "minExperience", "value": "", "description": "Minimum experience years", "disabled": true },
                    { "key": "sortBy", "value": "searchScore" },
                    { "key": "sortOrder", "value": "desc" }
                  ]
                },
                "description": "Search attorneys by keyword with optional filters. If a user is logged in, search is recorded in history."
              }
            }
          ]
        },
        {
          "name": "Reviews (Public)",
          "description": "Publicly viewable attorney reviews.",
          "item": [
            {
              "name": "Get Attorney Reviews (Public)",
              "request": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{marketplaceUrl}}/attorneys/{{attorneyProfileId}}/reviews?page=1&limit=20&status=PUBLISHED&sortBy=createdAt&sortOrder=desc",
                  "host": ["{{marketplaceUrl}}"],
                  "path": ["attorneys", "{{attorneyProfileId}}", "reviews"],
                  "query": [
                    { "key": "page", "value": "1" },
                    { "key": "limit", "value": "20" },
                    { "key": "status", "value": "PUBLISHED", "description": "PENDING | PUBLISHED | FLAGGED | HIDDEN" },
                    { "key": "rating", "value": "", "description": "Exact rating (1-5)", "disabled": true },
                    { "key": "minRating", "value": "", "description": "Minimum rating (1-5)", "disabled": true },
                    { "key": "sortBy", "value": "createdAt", "description": "createdAt | rating" },
                    { "key": "sortOrder", "value": "desc" }
                  ]
                },
                "description": "Get published reviews for a specific attorney. No auth required."
              }
            }
          ]
        },
        {
          "name": "Ranking",
          "description": "Attorney ranking weights configuration (read-only for public).",
          "item": [
            {
              "name": "Get Active Ranking Weights",
              "request": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{marketplaceUrl}}/ranking/weights",
                  "host": ["{{marketplaceUrl}}"],
                  "path": ["ranking", "weights"]
                },
                "description": "Retrieve the currently active ranking weights (verification, rating, experience, responsiveness). No auth required."
              }
            }
          ]
        }
      ]
    },
    {
      "name": "02. Client Role Superfolder",
      "description": "Endpoints used by authenticated Clients: booking consultations, managing cases, uploading documents, writing reviews, search history.",
      "item": [
        {
          "name": "Bookings",
          "description": "Create, view, cancel, and reschedule consultation bookings.",
          "item": [
            {
              "name": "Create Booking",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "if (pm.response.code === 201 || pm.response.code === 200) {",
                      "  const body = pm.response.json();",
                      "  if (body.id) pm.environment.set('bookingId', body.id);",
                      "}"
                    ],
                    "type": "text/javascript"
                  }
                }
              ],
              "request": {
                "auth": {
                  "type": "bearer",
                  "bearer": [{ "key": "token", "value": "{{clientAuthToken}}", "type": "string" }]
                },
                "method": "POST",
                "header": [
                  { "key": "Content-Type", "value": "application/json" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"attorneyId\": \"{{attorneyProfileId}}\",\n  \"bookingDate\": \"2026-08-20\",\n  \"startTime\": \"10:00\",\n  \"endTime\": \"11:00\",\n  \"consultationType\": \"VIDEO\",\n  \"paymentStatus\": \"UNPAID\"\n}"
                },
                "url": {
                  "raw": "{{marketplaceUrl}}/bookings",
                  "host": ["{{marketplaceUrl}}"],
                  "path": ["bookings"]
                },
                "description": "Create a new consultation booking with an attorney. Requires client auth.\n\n**consultationType**: IN_PERSON | VIDEO | PHONE\n**paymentStatus**: UNPAID | PAID | REFUNDED\n**startTime/endTime**: HH:mm format (e.g. 09:30, 14:00)"
              }
            },
            {
              "name": "Get My Bookings (Client)",
              "request": {
                "auth": {
                  "type": "bearer",
                  "bearer": [{ "key": "token", "value": "{{clientAuthToken}}", "type": "string" }]
                },
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{marketplaceUrl}}/bookings?page=1&limit=20&role=CLIENT&sortBy=bookingDate&sortOrder=desc",
                  "host": ["{{marketplaceUrl}}"],
                  "path": ["bookings"],
                  "query": [
                    { "key": "page", "value": "1" },
                    { "key": "limit", "value": "20" },
                    { "key": "role", "value": "CLIENT", "description": "CLIENT | ATTORNEY | ADMIN" },
                    { "key": "status", "value": "", "description": "PENDING | CONFIRMED | CANCELLED | COMPLETED | NOSHOW | EXPIRED", "disabled": true },
                    { "key": "paymentStatus", "value": "", "description": "UNPAID | PAID | REFUNDED", "disabled": true },
                    { "key": "consultationType", "value": "", "description": "IN_PERSON | VIDEO | PHONE", "disabled": true },
                    { "key": "fromDate", "value": "", "description": "ISO date filter start", "disabled": true },
                    { "key": "toDate", "value": "", "description": "ISO date filter end", "disabled": true },
                    { "key": "sortBy", "value": "bookingDate", "description": "bookingDate | createdAt | status | paymentStatus" },
                    { "key": "sortOrder", "value": "desc" }
                  ]
                },
                "description": "List all bookings for the authenticated client. Supports filtering by status, payment, consultation type, and date range."
              }
            },
            {
              "name": "Get Booking by ID",
              "request": {
                "auth": {
                  "type": "bearer",
                  "bearer": [{ "key": "token", "value": "{{clientAuthToken}}", "type": "string" }]
                },
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{marketplaceUrl}}/bookings/{{bookingId}}",
                  "host": ["{{marketplaceUrl}}"],
                  "path": ["bookings", "{{bookingId}}"]
                },
                "description": "Retrieve a specific booking by its ID."
              }
            },
            {
              "name": "Cancel Booking",
              "request": {
                "auth": {
                  "type": "bearer",
                  "bearer": [{ "key": "token", "value": "{{clientAuthToken}}", "type": "string" }]
                },
                "method": "POST",
                "header": [
                  { "key": "Content-Type", "value": "application/json" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"reason\": \"Schedule conflict - need to reschedule\"\n}"
                },
                "url": {
                  "raw": "{{marketplaceUrl}}/bookings/{{bookingId}}/cancel",
                  "host": ["{{marketplaceUrl}}"],
                  "path": ["bookings", "{{bookingId}}", "cancel"]
                },
                "description": "Cancel an existing booking. Reason is optional."
              }
            },
            {
              "name": "Reschedule Booking",
              "request": {
                "auth": {
                  "type": "bearer",
                  "bearer": [{ "key": "token", "value": "{{clientAuthToken}}", "type": "string" }]
                },
                "method": "POST",
                "header": [
                  { "key": "Content-Type", "value": "application/json" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"bookingDate\": \"2026-08-22\",\n  \"startTime\": \"14:00\",\n  \"endTime\": \"15:00\"\n}"
                },
                "url": {
                  "raw": "{{marketplaceUrl}}/bookings/{{bookingId}}/reschedule",
                  "host": ["{{marketplaceUrl}}"],
                  "path": ["bookings", "{{bookingId}}", "reschedule"]
                },
                "description": "Reschedule a booking to a new date/time.\n\n**bookingDate**: ISO date (YYYY-MM-DD)\n**startTime/endTime**: HH:mm format"
              }
            }
          ]
        },
        {
          "name": "Cases",
