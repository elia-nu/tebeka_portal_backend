                    { "key": "fromOpenedAt", "value": "", "disabled": true },
                    { "key": "toOpenedAt", "value": "", "disabled": true },
                    { "key": "sortBy", "value": "openedAt", "description": "openedAt | closedAt | priority | title" },
                    { "key": "sortOrder", "value": "desc" }
                  ]
