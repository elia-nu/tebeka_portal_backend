                  "type": "bearer",
                  "bearer": [{ "key": "token", "value": "{{clientAuthToken}}", "type": "string" }]
                },
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{marketplaceUrl}}/cases/{{caseId}}",
                  "host": ["{{marketplaceUrl}}"],
                  "path": ["cases", "{{caseId}}"]
                },
                "description": "Get details of a specific case by ID."
              }
            }
          ]
        },
        {
          "name": "Case Documents",
          "description": "Upload and manage documents for a legal case.",
          "item": [
