    "@nestjs/terminus": "^10.3.0",
    "@nestjs/throttler": "^5.1.1",
    "@nestjs/websockets": "^10.3.0",
    "@prisma/client": "^5.9.1",
    "@thallesp/nestjs-better-auth": "^2.4.0",
