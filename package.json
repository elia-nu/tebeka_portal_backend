    "@nx/webpack": "^18.3.5",
    "@nx/workspace": "^18.3.5",
    "@types/amqplib": "^0.10.5",
    "@types/bcrypt": "^5.0.2",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
