{
  "name": "@workspace/source",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "start:dev:gateway": "nx serve api-gateway",
    "start:dev:user": "nx serve user-service",
    "start:dev:marketplace": "nx serve marketplace-service",
    "start:dev:financial": "nx serve financial-service",
    "start:dev:communication": "nx serve communication-service",
    "start:all": "npx nx run-many --target=serve --all --parallel",
    "start:dev:all": "npx nx run-many --target=serve --all --parallel",
    "build:all": "nx run-many --target=build --all",
    "test": "jest",
    "test:all": "nx run-many --target=test --all",
    "lint:all": "nx run-many --target=lint --all",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "prisma:generate:user": "prisma generate --schema=apps/user-service/prisma/schema.prisma",
    "prisma:generate:marketplace": "prisma generate --schema=apps/marketplace-service/prisma/schema.prisma",
    "prisma:generate:financial": "prisma generate --schema=apps/financial-service/prisma/schema.prisma",
    "prisma:generate:communication": "prisma generate --schema=apps/communication-service/prisma/schema.prisma",
    "prisma:generate:all": "npm run prisma:generate:user && npm run prisma:generate:marketplace && npm run prisma:generate:financial && npm run prisma:generate:communication",
    "seed:admin": "ts-node -r dotenv/config apps/user-service/src/seed_test_users.ts",
    "seed:users": "ts-node -r dotenv/config apps/user-service/src/seed_test_users.ts",
    "routes": "node list-routes.js",
    "endpoints": "node list-routes.js",
    "track": "node track-endpoints.js",
    "monitor": "node track-endpoints.js"
  },
  "workspaces": [
    "apps/*",
    "libs/*"
  ],
  "dependencies": {
    "@better-auth/prisma-adapter": "^1.6.26",
    "@nestjs-modules/mailer": "^1.10.1",
    "@nestjs/axios": "^4.0.1",
    "@nestjs/common": "^10.3.0",
    "@nestjs/config": "^3.1.1",
    "@nestjs/core": "^10.3.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/microservices": "^10.3.0",
    "@nestjs/passport": "^10.0.3",
